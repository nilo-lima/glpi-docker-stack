# =============================================================================
#  Caddy — Reverse Proxy + TLS automático para GLPI 11
# =============================================================================
#  Recursos:
#    - HTTPS automático via Let's Encrypt (ACME HTTP-01 challenge)
#    - HTTP/3 (QUIC) habilitado por padrão
#    - Headers de segurança (HSTS, CSP-friendly, X-Frame-Options)
#    - Compressão (gzip + zstd)
#    - Rate limiting básico contra brute force
#    - Logs estruturados em JSON
# =============================================================================

{
	# Configuração global
	email {$ACME_EMAIL}
	admin off

	servers {
		protocols h1 h2 h3
	}

	# Logs JSON estruturados (compatível com Loki na Fase 2)
	log {
		output stdout
		format json
		level INFO
	}
}

# -----------------------------------------------------------------------------
# Endpoint de healthcheck (HTTP, sem TLS — usado pelo Docker healthcheck)
# -----------------------------------------------------------------------------
:80 {
	@health path /health
	respond @health 200 {
		body "OK"
		close
	}
}

# -----------------------------------------------------------------------------
# Site principal — GLPI
# -----------------------------------------------------------------------------
{$GLPI_DOMAIN} {

	# --- Headers de segurança ---
	header {
		# HSTS — força HTTPS por 2 anos
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		# Anti-clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Anti-MIME-sniffing
		X-Content-Type-Options "nosniff"

		# Privacidade do referrer
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions Policy (ex-Feature Policy)
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# Remove header que vaza versão do servidor
		-Server
		-X-Powered-By
	}

	# --- Compressão ---
	encode zstd gzip

	# --- Rate limit no endpoint de login (anti brute-force) ---
	# Caddy nativo não tem rate limit; deixamos preparado para plugin futuro
	# ou WAF na borda. Em produção crítica, considere CrowdSec ou Cloudflare.

	# --- Reverse proxy para o container glpi-app ---
	reverse_proxy glpi-app:80 {
		# Repassa headers reais para o GLPI
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Timeouts adequados para uploads grandes (anexos GLPI)
		transport http {
			read_timeout 300s
			write_timeout 300s
			dial_timeout 10s
		}
	}

	# --- Logs por site ---
	log {
		output stdout
		format json
	}
}
