# ==============================================================================
#  GLPI 11 Production Stack — Variáveis de Ambiente
# ==============================================================================
#  Copie este arquivo para .env e ajuste os valores.
#  Permissões recomendadas: chmod 600 .env
#  NUNCA commite o arquivo .env real no Git.
# ==============================================================================

# -----------------------------------------------------------------------------
# Identificação do projeto (prefixo de containers, networks, volumes)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=glpi-prod

# -----------------------------------------------------------------------------
# Domínio público e TLS (Caddy)
# -----------------------------------------------------------------------------
# Domínio FQDN apontado para o IP público do servidor.
# Para teste local, use algo como "glpi.localhost" e o Caddy gerará cert interno.
GLPI_DOMAIN=glpi.exemplo.com.br

# E-mail para o Let's Encrypt (avisos de expiração)
ACME_EMAIL=admin@exemplo.com.br

# -----------------------------------------------------------------------------
# Versões pinadas (NUNCA usar 'latest' em produção)
# -----------------------------------------------------------------------------
GLPI_IMAGE_TAG=11.0.7
MARIADB_IMAGE_TAG=11.4
REDIS_IMAGE_TAG=7.4-alpine
CADDY_IMAGE_TAG=2.8-alpine

# -----------------------------------------------------------------------------
# Banco de dados MariaDB
# -----------------------------------------------------------------------------
# IMPORTANTE: gere senhas fortes. Sugestão:
#   openssl rand -base64 32
# Use sempre aspas duplas — senhas com @, #, $, espaço quebram o source do .env sem elas.
MARIADB_ROOT_PASSWORD="TROCAR_root_senha_forte_aqui"
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD="TROCAR_glpi_senha_forte_aqui"

# -----------------------------------------------------------------------------
# GLPI — auto-instalação
# -----------------------------------------------------------------------------
# A imagem oficial roda o instalador automaticamente na primeira subida.
# Após primeira execução bem-sucedida, recomenda-se setar GLPI_SKIP_AUTOINSTALL=true.
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false

# Cron interno do GLPI (mantemos desativado no container web e ligado no container dedicado)
GLPI_CRONTAB_ENABLED=false

# Timezone usado pelo container GLPI (PHP)
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Redis (cache e sessões)
# -----------------------------------------------------------------------------
# Senha do Redis (acessível apenas pela rede interna, mas adicionamos auth por defesa em profundidade)
REDIS_PASSWORD="TROCAR_redis_senha_forte_aqui"

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
# Cron schedule para o backup automático (formato cron padrão).
# Default: 03:00 todo dia.
BACKUP_CRON_SCHEDULE="0 3 * * *"

# Quantos dias de backup manter (rotação)
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Limites de recursos (ajuste conforme hardware do host)
# -----------------------------------------------------------------------------
GLPI_MEMORY_LIMIT=1G
MARIADB_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=256M
