# ==============================================================================
#  GLPI 11 + Observabilidade — Variáveis de Ambiente (unificado)
# ==============================================================================
#  Copie para .env e ajuste os valores.
#  Permissões: chmod 600 .env
#  NUNCA commite o .env real no Git.
# ==============================================================================

# -----------------------------------------------------------------------------
# Identificação do projeto (prefixo de containers, networks, volumes)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=glpi-dev

# -----------------------------------------------------------------------------
# Domínios públicos e TLS (Caddy)
# -----------------------------------------------------------------------------
# GLPI_DOMAIN: FQDN apontado para o IP do servidor
# GRAFANA_DOMAIN: subdomínio para o Grafana (precisa de DNS separado)
# Para teste local: use .localhost — Caddy gera cert interno automaticamente
GLPI_DOMAIN=glpi.exemplo.com.br
GRAFANA_DOMAIN=grafana.glpi.exemplo.com.br
ACME_EMAIL=admin@exemplo.com.br

# -----------------------------------------------------------------------------
# Versões pinadas (NUNCA usar 'latest' em produção)
# -----------------------------------------------------------------------------
GLPI_IMAGE_TAG=11.0.7
MARIADB_IMAGE_TAG=11.4
REDIS_IMAGE_TAG=7.4-alpine
CADDY_IMAGE_TAG=2.8-alpine

# -----------------------------------------------------------------------------
# Banco de dados MariaDB
# -----------------------------------------------------------------------------
# Gere senhas fortes: openssl rand -base64 32
MARIADB_ROOT_PASSWORD="TROCAR_root_senha_forte_aqui"
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD="TROCAR_glpi_senha_forte_aqui"

# -----------------------------------------------------------------------------
# GLPI — auto-instalação
# -----------------------------------------------------------------------------
# Na primeira subida, mantenha false. Após instalação bem-sucedida, mude para true.
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false
GLPI_CRONTAB_ENABLED=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD="TROCAR_redis_senha_forte_aqui"

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_CRON_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD="TROCAR_grafana_senha_forte_aqui"
# Chave para assinar sessões: openssl rand -hex 32
GRAFANA_SECRET_KEY="TROCAR_grafana_secret_key_hex_aqui"

# -----------------------------------------------------------------------------
# MariaDB — usuário dedicado de monitoramento (mysqld-exporter)
# ATENÇÃO: @ e / são especiais em DSN MySQL — evite-os nesta senha.
# Use: openssl rand -base64 18 | tr -d '@/+'
# Após configurar, execute: ./scripts/setup-monitoring-user.sh
# -----------------------------------------------------------------------------
MARIADB_MONITORING_PASSWORD="TROCAR_monitoring_senha_forte_aqui"

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Retenção do Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION=30d

# -----------------------------------------------------------------------------
# Limites de recursos — ajuste conforme hardware do host
# -----------------------------------------------------------------------------
GLPI_MEMORY_LIMIT=1G
MARIADB_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=256M
PROMETHEUS_MEMORY_LIMIT=1G
GRAFANA_MEMORY_LIMIT=512M
LOKI_MEMORY_LIMIT=512M
ALERTMANAGER_MEMORY_LIMIT=128M
NODE_EXPORTER_MEMORY_LIMIT=64M
MYSQLD_EXPORTER_MEMORY_LIMIT=64M
REDIS_EXPORTER_MEMORY_LIMIT=64M
PROMTAIL_MEMORY_LIMIT=128M
