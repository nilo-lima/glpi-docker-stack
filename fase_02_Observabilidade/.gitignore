# ==============================================================================
#  .gitignore — GLPI 11 + Observabilidade (Fase 2)
#  Blindagem contra vazamento de credenciais e dados de produção.
# ==============================================================================

# --- Segredos e configuração local ---
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
.secrets/

# --- Credenciais geradas por scripts ---
# Gerado por: ./scripts/setup-monitoring-user.sh
services/mysqld-exporter/config/.my.cnf

# --- Dados persistentes (jamais versionar) ---
services/caddy/data/*
!services/caddy/data/.gitkeep
services/caddy/config/*.json
backups/
data/
volumes/

# --- Logs ---
*.log
logs/
services/*/logs/

# --- Arquivos temporários ---
*.tmp
*.swp
*.bak
*~
.DS_Store
Thumbs.db

# --- IDE / Editor ---
.vscode/
.idea/
*.sublime-*

# --- Python (utilitários) ---
__pycache__/
*.pyc
.venv/
venv/

# --- Node (caso adicione frontend tooling) ---
node_modules/

# --- Docker overrides locais ---
docker-compose.override.yml
docker-compose.local.yml

# --- Dumps de banco ---
*.sql
*.sql.gz
*.dump

# --- Claude Code: settings locais com secrets de MCP ---
.claude/settings.local.json
.claude/settings.json
CLAUDE.local.md
CLAUDE.md
.claude/
.mcp.json

# --- Docs com informação específica do ambiente (domínio real, e-mail) ---
# A versão genérica (AWS-DEPLOY.md) é versionada; a específica não.
docs/AWS-DEPLOY-FASE-2.md
